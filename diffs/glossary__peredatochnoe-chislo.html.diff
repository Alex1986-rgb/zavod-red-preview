+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Передаточное число редуктора: определение и влияние на подбор", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "description": "Передаточное число редуктора: точное инженерное определение, как параметр i влияет на момент, обороты и подбор привода, типовые значения и единицы.", "mainEntityOfPage": "https://zavod-red.ru/glossary/peredatochnoe-chislo", "datePublished": "2026-06-29", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
