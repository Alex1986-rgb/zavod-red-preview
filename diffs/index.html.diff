+/* ===== Иллюстрации в статьях (правило канона zavod-content, п.7) =====
+   Раньше стили .art-fig дублировались инлайном в каждой статье — у 535 статей
+   их не было вовсе. Теперь правило одно и живёт здесь: inner.css грузят все
+   статьи блога, глоссария, отраслей и услуг. .art-fig-dw — вариант для
+   ГАБАРИТНЫХ ЧЕРТЕЖЕЙ: штриховая графика на белом, её нельзя обрезать
+   (object-fit:contain) и нельзя красить фоном страницы. */
+.art-fig{margin:26px 0}
+.art-fig img{width:100%;border-radius:12px;border:1px solid var(--line);display:block}
+.art-fig figcaption{color:var(--muted2);font-size:13px;margin-top:8px;text-align:center}
+.art-fig-dw img{background:#fff;object-fit:contain;max-height:520px;padding:10px}
+.art-fig-dw figcaption a{color:var(--red);text-decoration:none;border-bottom:1px solid transparent}
+.art-fig-dw figcaption a:hover{border-bottom-color:currentColor}
+@media(max-width:560px){.art-fig{margin:20px 0}.art-fig-dw img{max-height:360px}}
+/* ===== Компакт-режим секции «Что мы производим и поставляем» =====
+   Задача: весь блок (заголовок + маркировки + типы передач) помещается
+   в один экран на десктопе. Правила ограничены #catalog, поэтому карточки
+   тех же классов на других страницах не затрагиваются. */
+@media(min-width:981px){
+  #catalog.section{padding:52px 0}
+  #catalog .eyebrow{margin-bottom:8px}
+  #catalog h2{font-size:clamp(24px,2.3vw,32px);margin-bottom:8px}
+  #catalog .lead{font-size:14.5px;line-height:1.5;max-width:1000px;margin-bottom:0}
+  #catalog .grid-lbl{margin:20px 0 12px}
+
+  /* маркировки: карточка становится горизонтальной — фото слева, текст справа */
+  #catalog .prod-grid{gap:14px}
+  #catalog .prod-card{flex-direction:row;align-items:stretch}
+  #catalog .prod-img{flex:0 0 116px;width:116px;border-bottom:none;border-right:1px solid var(--line);display:flex;align-items:center;justify-content:center}
+  #catalog .prod-img img{width:100%;height:100%;aspect-ratio:auto;object-fit:contain;padding:8px}
+  #catalog .prod-b{padding:11px 13px;gap:4px}
+  #catalog .prod-mark{font-size:10px}
+  #catalog .prod-card b{font-size:14px;line-height:1.25}
+  #catalog .prod-d{font-size:12px;line-height:1.42;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
+  #catalog .prod-n{font-size:11px;padding-top:2px}
+  #catalog .prod-go{font-size:12px}
+  #catalog .prod-go svg{width:13px;height:13px}
+
+  /* Типы передач — КРУПНЫЕ карточки (12.08.2026, по референсу конкурента).
+     Раньше здесь всё ужималось, чтобы секция влезала в один экран: фото 112px,
+     текст обрезался на второй строке. Заказчик попросил увеличить — описание
+     типа передачи должно читаться целиком, это то, ради чего блок и нужен.
+     Секция теперь занимает больше экрана; карточки марок выше остались сжатыми. */
+  #catalog .cat-grid{grid-template-columns:repeat(3,1fr);gap:18px}
+  #catalog .cat-img{height:210px}
+  #catalog .cat-img img{padding:14px}
+  #catalog .cat-body{padding:16px 18px 18px;gap:9px}
+  #catalog .cat-body h3{font-size:18px;line-height:1.25}
+  #catalog .cat-body p{font-size:14px;line-height:1.55}
+  #catalog .cat-models{font-size:12.5px;line-height:1.5}
+  #catalog .cat-actions{gap:10px;padding-top:14px}
+  #catalog .cat-actions .btn-sm{padding:9px 16px;font-size:13px}
+}
+/* Широкие экраны: три крупные карточки в ряд (было шесть мелких).
+   Шесть в ряд давали колонку ~200px — фото читалось как иконка, а описание
+   не помещалось. Три в ряд дают карточку ~430px: фото видно, текст целиком. */
+@media(min-width:1280px){
+  #catalog .cat-grid{grid-template-columns:repeat(3,1fr);gap:22px}
+  #catalog .cat-img{height:250px}
+  #catalog .cat-body{padding:18px 20px 20px}
+  #catalog .cat-body h3{font-size:19px}
+  #catalog .cat-body p{font-size:14.5px}
+  #catalog .cat-actions .btn-sm{flex:1;text-align:center;padding:10px 14px;font-size:13.5px}
+}
+/* средние экраны: колонок меньше, зато обе сетки — горизонтальными карточками,
+   иначе текст в узкой колонке рвётся и секция снова перестаёт влезать */
+@media(min-width:981px) and (max-width:1279px){
+  #catalog.section{padding:34px 0}
+  #catalog h2{font-size:26px}
+  #catalog .lead{font-size:14px;-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden}
+  #catalog .grid-lbl{margin:16px 0 10px}
+  #catalog .prod-grid{grid-template-columns:repeat(2,1fr);gap:12px}
+  #catalog .prod-d{-webkit-line-clamp:2}
+  /* Типы передач на среднем экране: две крупные карточки в ряд.
+     Горизонтальная компоновка с фото-полоской 104px здесь снята вместе
+     с обрезкой текста — заказчик просил увеличить блок (12.08.2026). */
+  #catalog .cat-grid{grid-template-columns:repeat(2,1fr);gap:18px}
+  #catalog .cat-item{flex-direction:column}
+  #catalog .cat-img{flex:0 0 auto;width:100%;height:220px;border-bottom:1px solid var(--line);border-right:none}
+  #catalog .cat-body{padding:16px 18px 18px}
+  #catalog .cat-body h3{font-size:17.5px}
+  #catalog .cat-body p{font-size:14px;line-height:1.55}
+  #catalog .cat-models{font-size:12.5px;line-height:1.5}
+  #catalog .cat-actions{padding-top:13px}
+}
+@media(max-width:1080px){:root{--hdr:110px}}@media(max-width:560px){:root{--hdr:127px}}/* на главной у первого экрана своя красная кнопка; шапочную делаем контурной, чтобы красных не было четыре */
+body.home .hdr2 .zbtn,.hdr2 .zbtn{background:transparent;color:var(--h-red,#e2231a);border:1.5px solid var(--h-red,#e2231a);box-shadow:none}
