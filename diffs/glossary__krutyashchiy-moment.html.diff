+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Крутящий момент", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "description": "Крутящий момент в приводах и редукторах: инженерное определение, единицы измерения, формула расчёта и влияние на подбор редуктора по выходному моменту.", "mainEntityOfPage": "https://zavod-red.ru/glossary/krutyashchiy-moment", "datePublished": "2026-06-29", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
