+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Вибрация редуктора — что это, нормы и подбор", "description": "Вибрация редуктора: что это, единицы измерения (мм/с, СКЗ виброскорости), нормы по ГОСТ ИСО 10816, причины, как влияет на ресурс и подбор привода.", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "areaServed": "RU", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "mainEntityOfPage": "https://zavod-red.ru/glossary/vibraciya-reduktora", "datePublished": "2026-06-30", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
