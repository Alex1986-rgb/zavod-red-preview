+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Осевая нагрузка редуктора — что это, расчёт", "description": "Осевая нагрузка редуктора: инженерное определение, единицы (Н, кН), как осевая сила Fa на валу влияет на подбор редуктора, связь с радиальной нагрузкой и подшипниками.", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "areaServed": "RU", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "mainEntityOfPage": "https://zavod-red.ru/glossary/osevaya-nagruzka", "datePublished": "2026-06-30", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
