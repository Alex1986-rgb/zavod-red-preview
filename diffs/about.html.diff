+<script>
+/* Запуск видео «Завод изнутри» по клику.
+   ЗАЧЕМ. Блок .vfac показывает постер с кнопкой воспроизведения, а сам ролик
+   (12 МБ) лежит в data-src и грузится только по требованию — чтобы не тянуть его
+   на каждом заходе. Но обработчика клика в коде не было вовсе: кнопка рисовалась,
+   нажатие не делало ничего. Владелец так и сказал — «видео не работает».
+   Класс .vfac-video в стилях при этом есть, то есть скрипт был задуман и потерян.
+   25.09.2026 восстановлен. */
+(function(){
+  function zapustit(box){
+    if (box.dataset.zapushcheno) return;          // повторный клик не плодит копии
+    box.dataset.zapushcheno = '1';
+    var v = document.createElement('video');
+    v.className = 'vfac-video' + (box.classList.contains('vfac-sq') ? ' vfac-sq' : '');
+    v.src = box.getAttribute('data-src');
+    v.controls = true; v.autoplay = true; v.playsInline = true; v.preload = 'auto';
+    var poster = box.querySelector('img');
+    if (poster) v.poster = poster.getAttribute('src');
+    box.innerHTML = '';
+    box.appendChild(v);
+    // autoplay у видео со звуком браузер может отклонить — тогда остаются
+    // штатные элементы управления, человек нажмёт сам
+    var p = v.play(); if (p && p.catch) p.catch(function(){});
+  }
+  document.addEventListener('click', function(e){
+    var box = e.target && e.target.closest && e.target.closest('.vfac[data-src]');
+    if (box) { e.preventDefault(); zapustit(box); }
+  });
+  // с клавиатуры: кнопка внутри блока должна срабатывать по Enter и пробелу
+  document.addEventListener('keydown', function(e){
+    if (e.key !== 'Enter' && e.key !== ' ') return;
+    var b = document.activeElement;
+    if (b && b.classList && b.classList.contains('vfac-btn')) {
+      var box = b.closest('.vfac[data-src]');
+      if (box) { e.preventDefault(); zapustit(box); }
+    }
+  });
+})();
+</script>
