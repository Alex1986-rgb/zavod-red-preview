+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Планетарный редуктор: устройство, параметры и подбор", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "description": "Планетарный редуктор: устройство, передаточные числа, КПД и моменты, как соосность и нагрузочная способность влияют на подбор привода и его аналогов.", "mainEntityOfPage": "https://zavod-red.ru/glossary/planetarnyy-reduktor", "datePublished": "2026-06-29", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
