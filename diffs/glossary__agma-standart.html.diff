-  <img src="../assets/blog-photo/th-blueprint.webp" alt="Стандарт AGMA для зубчатых передач и редукторов" loading="lazy" style="width:100%;max-height:330px;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin-bottom:26px">
