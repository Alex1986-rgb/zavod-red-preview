-  <img src="../assets/blog-photo/th-steel-gears.webp" alt="Цементация зубьев зубчатых колёс редуктора" loading="lazy" style="width:100%;max-height:330px;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin-bottom:26px">
