+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Цилиндрический редуктор", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "description": "Цилиндрический редуктор: инженерное определение, КПД 0,96–0,98, передаточное число, типы зацепления и как параметры влияют на подбор привода.", "mainEntityOfPage": "https://zavod-red.ru/glossary/cilindricheskiy-reduktor", "datePublished": "2026-06-29", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
