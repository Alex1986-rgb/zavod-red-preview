+<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Подбор редуктора по крутящему моменту: формула и калькулятор","description":"Как подобрать редуктор по крутящему моменту на выходе: формула T=9550·P·η/n2, расчёт момента из мощности, сервис-фактор и запас по моменту.","image":"https://zavod-red.ru/assets/blog-photo/th-engineer-select.webp","author":{"@type":"Organization","areaServed":"RU","name":"Завод Редукторов"},"publisher":{"@type":"Organization","areaServed":"RU","name":"Завод Редукторов","logo":{"@type":"ImageObject","url":"https://zavod-red.ru/assets/zr_logo.webp"}},"mainEntityOfPage":"https://zavod-red.ru/blog/podbor-reduktora-po-momentu","datePublished":"2026-06-29","dateModified":"2026-08-26"}</script>
