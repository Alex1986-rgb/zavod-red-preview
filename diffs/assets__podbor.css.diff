--- main/assets/podbor.css
+++ prod/assets/podbor.css
@@ -96,3 +96,3 @@
 
-@media(max-width:680px){
+@media(max-width:1000px){
   .pf-ask{flex-direction:column;align-items:stretch;text-align:center}
@@ -164 +164,33 @@
 .pf-brands--panel .pf-pill--brand.is-nodata:hover{opacity:1}
+
+/* Иконка марки в чипе калькулятора: клиент узнаёт логотип быстрее, чем читает название.
+   Логотипов нет у Rossi, Tos Znojmo и Vemper — там onerror убирает <img>, остаётся текст. */
+.pf-pill--brand{display:inline-flex;align-items:center;gap:7px}
+.pf-pill-ic{height:15px;width:auto;max-width:46px;object-fit:contain;flex-shrink:0;opacity:.85;transition:opacity .15s}
+.pf-pill--brand:hover .pf-pill-ic{opacity:1}
+.pf-pill--brand.is-active .pf-pill-ic{filter:brightness(0) invert(1);opacity:1}
+.pf-pill--brand.is-nodata .pf-pill-ic{opacity:.4}
+
+/* Карточки типоразмеров марки без параметрического подбора */
+.pf-bcards{margin:10px 0 4px;padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:var(--card)}
+.pf-bc-lbl{font:700 13px/1.3 'Space Grotesk',sans-serif;color:var(--text);margin-bottom:10px}
+.pf-bc-lbl i{display:block;font:400 12px/1.4 inherit;color:var(--muted);margin-top:3px}
+.pf-bc-set{display:flex;flex-wrap:wrap;gap:7px}
+.pf-bc{display:inline-block;padding:6px 12px;border:1px solid var(--line);border-radius:8px;font:600 12.5px/1 'IBM Plex Mono',monospace;color:var(--text);text-decoration:none;background:var(--bg)}
+.pf-bc:hover{border-color:var(--red);color:var(--red)}
+
+/* ПЕРЕХОД НА СТРАНИЦУ МАРКИ / ТИПА (заказчик 08.08.2026).
+   Пилюля остаётся фильтром калькулятора, а стрелка ↗ в её правом углу открывает раздел.
+   Обёртка .pf-pill-w нужна потому, что вкладывать <a> внутрь <button> нельзя. */
+.pf-pill-w{position:relative;display:inline-flex;align-items:center}
+.pf-pill-w .pf-pill.has-go{padding-right:28px}
+.pf-pill-go{position:absolute;right:5px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;
+  width:19px;height:19px;border-radius:6px;font-size:12px;line-height:1;color:var(--muted,#7c8b95);text-decoration:none;opacity:.6;transition:.14s}
+.pf-pill-go:hover{opacity:1;color:#fff;background:var(--red,#cf1616)}
+.pf-pill-w .pf-pill.is-active+.pf-pill-go{color:#fff;opacity:.85}
+.pf-pill-w .pf-pill.is-active+.pf-pill-go:hover{background:rgba(255,255,255,.22);color:#fff}
+/* Марка без параметрической базы — вся плашка ссылка на страницу марки */
+.pf-pill--brand.is-link{text-decoration:none}
+.pf-pill--brand.is-link:hover{border-color:var(--red,#cf1616);color:var(--red,#cf1616);opacity:1}
+.pf-pill--brand.is-link::after{content:"\2197";margin-left:2px;font-size:11px;opacity:.7}
+@media(max-width:560px){.pf-pill-go{width:17px;right:4px}.pf-pill-w .pf-pill.has-go{padding-right:25px}}