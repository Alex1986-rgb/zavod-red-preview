-<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Какой максимальный крутящий момент у редукторов Varvel?", "acceptedAnswer": {"@type": "Answer", "text": "Ориентировочно червячные серии держат до ~1500 Н·м, соосные RS/RT и коническо-цилиндрические RN/RO — до ~10000 Н·м и выше в крупных типоразмерах. Точный предельный момент зависит от конкретного типоразмера корпуса и режима работы — его сверяют по каталогу и шильдику."}}, {"@type": "Question", "name": "Какие передаточные числа доступны в Varvel?", "acceptedAnswer": {"@type": "Answer", "text": "Червячные одноступенчатые дают i от 5 до 100, червячно-цилиндрические — до 1000 и выше. Соосные серии — от 3,5 до 350, коническо-цилиндрические — 5–400. Для очень больших передаточных чисел применяют комбинированные червячно-цилиндрические схемы."}}, {"@type": "Question", "name": "Какой КПД у редукторов Varvel?", "acceptedAnswer": {"@type": "Answer", "text": "КПД зависит от типа передачи: соосные и коническо-цилиндрические серии дают 0,96–0,98 на ступень, червячные — 0,7–0,9 и заметно ниже с ростом передаточного числа. Поэтому при выборе червячного редуктора на большое i закладывают запас по мощности двигателя."}}, {"@type": "Question", "name": "Какие мощности двигателей у мотор-редукторов Varvel?", "acceptedAnswer": {"@type": "Answer", "text": "Типовой ряд асинхронных двигателей — от 0,12 до 15–22 кВт и выше, с числом полюсов 2, 4 или 6 (3000, 1500, 1000 об/мин). Габарит двигателя привязан к стандарту IEC, что позволяет подобрать российский двигатель к аналогу по фланцу и полюсности."}}, {"@type": "Question", "name": "Как выбрать типоразмер Varvel под нагрузку?", "acceptedAnswer": {"@type": "Answer", "text": "Определяют требуемый момент на выходе M₂, обороты n₂ и мощность, закладывают сервис-фактор под режим (S1–S8, ударность, число пусков) и подбирают типоразмер с запасом. Для замены существующего Varvel берут параметры с шильдика и подбирают аналог по габаритам."}}, {"@type": "Question", "name": "Есть ли российские аналоги характеристик Varvel?", "acceptedAnswer": {"@type": "Answer", "text": "Да. Серия ZR повторяет присоединительные и габаритные размеры массовых типоразмеров Varvel по соосным, червячным и коническо-цилиндрическим сериям. Подбор ведут по моменту M₂, оборотам n₂, передаточному i, мощности и исполнению — аналог встаёт на штатное место без переделки."}}]}</script>
