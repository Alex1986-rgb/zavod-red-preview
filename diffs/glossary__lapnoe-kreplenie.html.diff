+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Лапное крепление", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "description": "Лапное крепление редуктора: точное определение, монтажные исполнения (B3, B6, B7, B8, V5, V6), влияние на подбор, типовые размеры и связь с фланцем и опорами.", "mainEntityOfPage": "https://zavod-red.ru/glossary/lapnoe-kreplenie", "datePublished": "2026-06-29", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
