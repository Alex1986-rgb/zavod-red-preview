-  <img src="../assets/blog-photo/th-calculation.webp" alt="Эквивалентный крутящий момент редуктора" loading="lazy" style="width:100%;max-height:330px;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin-bottom:26px">
