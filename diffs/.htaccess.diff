 </FilesMatch>
+# Рабочий конфиг бэкенда: правило выше закрывает только `config.php`, а пароль БД
+# лежит в `config.local.php` — он отдавался снаружи с кодом 200. Сейчас его исполняет
+# PHP и тело пустое, но защита держалась ровно на том, что обработчик жив: сбой PHP
+# или смена обработчика в панели — и наружу ушёл бы исходник с доступами.
+<FilesMatch "^config\.local.*\.php$">
+  <IfModule mod_authz_core.c>
+    Require all denied
+  </IfModule>
+  <IfModule !mod_authz_core.c>
+    Order deny,allow
+    Deny from all
+  </IfModule>
+</FilesMatch>
+# Служебные файлы репозитория, уезжающие на бой вместе с сайтом. `.worktreeinclude`
+# отдавался с кодом 200 и содержал строку `api/config.local.php` — то есть прямо
+# показывал, где лежит конфиг. `.index-state.json` — карта всех адресов сайта на 15 МБ,
+# её скачивание ещё и бесплатно грузит хостинг. Имя начинается с точки, поэтому
+# под правило по расширениям не попадает.
+<FilesMatch "^\.">
+  <IfModule mod_authz_core.c>
+    Require all denied
+  </IfModule>
+  <IfModule !mod_authz_core.c>
+    Order deny,allow
+    Deny from all
+  </IfModule>
+</FilesMatch>
+# Служебные каталоги инструментов: состав окружения, порты, настройки агентов.
+RedirectMatch 403 ^/\.claude/.*$
+RedirectMatch 403 ^/\.github/.*$
+# Архивы, которые мы сами складываем рядом перед удалением. Лежат в веб-корне,
+# поэтому без этого правила их содержимое снова отдавалось бы наружу — а это ровно
+# те страницы-дубли, ради устранения которых архив и создавался.
+RedirectMatch 403 ^/_koren_dubli[^/]*/.*$
+RedirectMatch 403 ^/_arhiv[^/]*/.*$
+# Сборочные файлы и архивы, уехавшие на бой по недосмотру. Архив отдавался целиком
+# на 10,7 МБ — бесплатная нагрузка на хостинг, который мы уже роняли по лимитам.
+<FilesMatch "^(?:Dockerfile|docker-compose\.ya?ml)$">
+  <IfModule mod_authz_core.c>
+    Require all denied
+  </IfModule>
+  <IfModule !mod_authz_core.c>
+    Order deny,allow
+    Deny from all
+  </IfModule>
+</FilesMatch>
+RedirectMatch 403 ^/zavod-3-tiporazmer\.zip$
+# Копии страниц вида index.html.bak-20260810 и index_old_*.html: правило по расширениям
+# их не ловит (после .bak идёт дата), а отдавались они с кодом 200 — то есть полные
+# дубли главной конкурировали с ней же в выдаче.
+<FilesMatch "\.(?:bak|orig|backup)[-_.0-9a-zA-Z]*$">
+  <IfModule mod_authz_core.c>
+    Require all denied
+  </IfModule>
+  <IfModule !mod_authz_core.c>
+    Order deny,allow
+    Deny from all
+  </IfModule>
+</FilesMatch>
+RedirectMatch 403 ^/index(?:_old|_backup|_broken)[^/]*\.html$
