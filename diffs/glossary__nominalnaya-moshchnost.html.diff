+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Номинальная мощность редуктора — что это | Глоссарий", "description": "Номинальная мощность редуктора и мотор-редуктора: определение, формула P=T·ω, единицы (кВт), связь с моментом и оборотами, влияние на подбор типоразмера и ресурс.", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "areaServed": "RU", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "mainEntityOfPage": "https://zavod-red.ru/glossary/nominalnaya-moshchnost", "datePublished": "2026-06-30", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
