+<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Степень защиты IP редуктора — что это", "description": "Степень защиты IP редуктора и мотор-редуктора: что означают цифры (IP54, IP55, IP65), расшифровка по ГОСТ 14254, как влияет на подбор привода и условия эксплуатации.", "author": {"@type": "Organization", "name": "Завод Редукторов"}, "publisher": {"@type": "Organization", "name": "ООО «НИИ АТТ»", "areaServed": "RU", "logo": {"@type": "ImageObject", "url": "https://zavod-red.ru/assets/zr_logo.webp"}}, "mainEntityOfPage": "https://zavod-red.ru/glossary/ip-zashchita", "datePublished": "2026-06-30", "dateModified": "2026-08-26", "image": "https://zavod-red.ru/assets/blog-photo/th-steel-gears.webp"}</script>
