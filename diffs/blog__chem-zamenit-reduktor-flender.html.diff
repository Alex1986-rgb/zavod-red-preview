+      <tr><td><b>H1</b></td><td>Цилиндрический, 1 ступень</td><td>03–13</td><td>момент 3 300–75 700 Н·м, i 1,25…5,6</td></tr>
+      <tr><td><b>H2</b></td><td>Цилиндрический, 2 ступени</td><td>03–14</td><td>момент 3 500–107 000 Н·м, i 6,3…28</td></tr>
+      <tr><td><b>H3</b></td><td>Цилиндрический, 3 ступени</td><td>05–14</td><td>момент 11 600–109 000 Н·м, i 22,4…112</td></tr>
+      <tr><td><b>H4</b></td><td>Цилиндрический, 4 ступени</td><td>07–14</td><td>момент 21 700–113 000 Н·м, i 100…450</td></tr>
