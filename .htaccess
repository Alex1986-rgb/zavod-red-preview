  RewriteRule ^reduktor/zr-959-939/?$ https://%{HTTP_HOST}/reduktor/evl-195-193 [R=301,L,NE]
  RewriteRule ^reduktor/zr-959x/?$ https://%{HTTP_HOST}/reduktor/evl-195x [R=301,L,NE]
