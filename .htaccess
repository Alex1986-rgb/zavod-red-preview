  # КЕЙСЫ: 18 почти одинаковых страниц по шести маркам схлопнуты в три сводные (25.09.2026).
  # Замер показал совпадение 0,893–0,902 внутри каждой тройки сценариев при 1,6–2,0 %
  # собственного текста: содержание сценария от марки не зависело. Файлы не удалены,
  # перенесены в cases/_shlopnutye/ и закрыты noindex; склейка идёт этими 301.
  # Ставим ДО общего правила «убрать .html» — иначе адрес с .html уходил бы двумя хопами.
  RewriteRule ^cases/zamena-boneng-bez-shildika(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-bez-shildika [R=301,L,NE]
  RewriteRule ^cases/zamena-flender-bez-shildika(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-bez-shildika [R=301,L,NE]
  RewriteRule ^cases/zamena-guomao-bez-shildika(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-bez-shildika [R=301,L,NE]
  RewriteRule ^cases/zamena-keb-bez-shildika(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-bez-shildika [R=301,L,NE]
  RewriteRule ^cases/zamena-siemens-bez-shildika(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-bez-shildika [R=301,L,NE]
  RewriteRule ^cases/zamena-unidrive-bez-shildika(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-bez-shildika [R=301,L,NE]
  RewriteRule ^cases/zamena-boneng-konveyer(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-na-konveyere [R=301,L,NE]
  RewriteRule ^cases/zamena-flender-konveyer(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-na-konveyere [R=301,L,NE]
  RewriteRule ^cases/zamena-guomao-konveyer(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-na-konveyere [R=301,L,NE]
  RewriteRule ^cases/zamena-keb-konveyer(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-na-konveyere [R=301,L,NE]
  RewriteRule ^cases/zamena-siemens-konveyer(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-na-konveyere [R=301,L,NE]
  RewriteRule ^cases/zamena-unidrive-konveyer(\.html)?/?$ https://%{HTTP_HOST}/cases/zamena-na-konveyere [R=301,L,NE]
  RewriteRule ^cases/srochnaya-zamena-boneng(\.html)?/?$ https://%{HTTP_HOST}/cases/srochnaya-zamena [R=301,L,NE]
  RewriteRule ^cases/srochnaya-zamena-flender(\.html)?/?$ https://%{HTTP_HOST}/cases/srochnaya-zamena [R=301,L,NE]
  RewriteRule ^cases/srochnaya-zamena-guomao(\.html)?/?$ https://%{HTTP_HOST}/cases/srochnaya-zamena [R=301,L,NE]
  RewriteRule ^cases/srochnaya-zamena-keb(\.html)?/?$ https://%{HTTP_HOST}/cases/srochnaya-zamena [R=301,L,NE]
  RewriteRule ^cases/srochnaya-zamena-siemens(\.html)?/?$ https://%{HTTP_HOST}/cases/srochnaya-zamena [R=301,L,NE]
  RewriteRule ^cases/srochnaya-zamena-unidrive(\.html)?/?$ https://%{HTTP_HOST}/cases/srochnaya-zamena [R=301,L,NE]

  # СТАРЫЕ ПРОИНДЕКСИРОВАННЫЕ URL с запятыми → чистые (301). Защита от потери индексации
  # при переименовании аналогов sew-k-57,-s-67 → sew-k-57-s-67. Работает и для нескольких запятых.
  RewriteCond %{REQUEST_URI} ^/(.*),-?(.*)$
  RewriteRule ^ /%1-%2 [R=301,L,NE]

  # любой /страница.html → /страница (301), сразу на https
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]


  # Чистые URL для заводских маркировок МР и ПР (вместо ?mr=/?pr=, которые закрыты
  # в robots.txt правилом «Disallow: /*?» и потому не индексировались вовсе).
  # Внутренняя подмена, НЕ редирект: адрес в строке остаётся человекочитаемым,
  # карточка сама подставляет маркировку по пути. canonical ведёт на карточку ZR,
  # поэтому дублей в индексе не возникает. 82 правила.


  # zr-underscore-301: подчёркивание в адресах карточек заменено на дефис (07.08.2026).
  # Google трактует «_» как склейку слов, дефис — как разделитель. Старые адреса
  # проиндексированы, поэтому уводим их 301-м, а не бросаем в 404.
  # Максимум подчёркиваний в слаге — два, поэтому хватает двух правил (сначала длинное).
  RewriteRule ^(analog|ispolnenie|tiporazmer|motor-reduktor-zr)/([^_/]+)_([^_/]+)_([^_/]+)/?$ https://%{HTTP_HOST}/$1/$2-$3-$4 [R=301,L,NE]
  RewriteRule ^(analog|ispolnenie|tiporazmer|motor-reduktor-zr)/([^_/]+)_([^_/]+)/?$ https://%{HTTP_HOST}/$1/$2-$3 [R=301,L,NE]

  # внутренне отдаём .html для чистого URL (если такой файл есть)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# YML-фид Яндекс.Маркета: отдавать как XML (без этого Content-Type пустой и Яндекс
# не распознаёт файл как фид). application/xml также попадает под gzip ниже.
<IfModule mod_mime.c>
  AddType application/xml .yml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  # КЭШ СТИЛЕЙ И СКРИПТОВ — ЧАС ВМЕСТО МЕСЯЦА (26.09.2026)
# Стили и скрипты кэшировались на месяц. Из-за этого любая правка оформления
# доходила до людей только после смены номера версии в ссылке — а ссылка эта
# стоит в 114 тысячах файлов, и прогон по ним занимает полдня и роняет сервер.
# Сегодня такой прогон пришлось делать вручную, и следующая же правка стилей
# упёрлась бы в то же самое.
# Час — разумный компромисс: браузер всё равно не скачивает файл заново, а
# спрашивает «не менялся ли» и получает короткий ответ «нет» (код 304).
# Трафика это почти не добавляет, зато правки доезжают сами.
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  # JSON-данные (podbor-data, import-catalog, search-index) версионируются через ?v= — кэшируем надолго
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # HTML — не кэшируем: страницы должны обновляться сразу (ассеты бьём через ?v=)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresDefault "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # HTML всегда ревалидируется на сервере (отдаётся 304, если не менялся) — клиент не залипает на старой версии
  <FilesMatch "\.(?:html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Защитные заголовки (РКН-аудит S01, 2026-06-16) ---
  # Принудительный HTTPS на год (сайт уже на валидном TLS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Запрет встраивания сайта в чужие iframe (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Запрет MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Не утекать полный URL рефереру на чужие домены
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Отключить ненужные браузерные API
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # Мягкий CSP: только апгрейд http-подресурсов в https (не ломает inline-скрипты/Метрику/model-viewer)
  Header always set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# Кастомная 404-страница (мягкая для пользователя + не «жёсткий» Apache-404 для роботов)
ErrorDocument 404 /404.html

# --- Защита бэкенда CRM (живёт в этом же корне; правила безвредны, даже если CRM нет) ---
Options -Indexes
<FilesMatch "^config\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# Рабочий конфиг бэкенда: правило выше закрывает только `config.php`, а пароль БД
# лежит в `config.local.php` — он отдавался снаружи с кодом 200. Сейчас его исполняет
# PHP и тело пустое, но защита держалась ровно на том, что обработчик жив: сбой PHP
# или смена обработчика в панели — и наружу ушёл бы исходник с доступами.
<FilesMatch "^config\.local.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# Служебные файлы репозитория, уезжающие на бой вместе с сайтом. `.worktreeinclude`
# отдавался с кодом 200 и содержал строку `api/config.local.php` — то есть прямо
# показывал, где лежит конфиг. `.index-state.json` — карта всех адресов сайта на 15 МБ,
# её скачивание ещё и бесплатно грузит хостинг. Имя начинается с точки, поэтому
# под правило по расширениям не попадает.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# Служебные каталоги инструментов: состав окружения, порты, настройки агентов.
RedirectMatch 403 ^/\.claude/.*$
RedirectMatch 403 ^/\.github/.*$
# Архивы, которые мы сами складываем рядом перед удалением. Лежат в веб-корне,
# поэтому без этого правила их содержимое снова отдавалось бы наружу — а это ровно
# те страницы-дубли, ради устранения которых архив и создавался.
RedirectMatch 403 ^/_koren_dubli[^/]*/.*$
RedirectMatch 403 ^/_arhiv[^/]*/.*$
# Сборочные файлы и архивы, уехавшие на бой по недосмотру. Архив отдавался целиком
# на 10,7 МБ — бесплатная нагрузка на хостинг, который мы уже роняли по лимитам.
<FilesMatch "^(?:Dockerfile|docker-compose\.ya?ml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/zavod-3-tiporazmer\.zip$
# Копии страниц вида index.html.bak-20260810 и index_old_*.html: правило по расширениям
# их не ловит (после .bak идёт дата), а отдавались они с кодом 200 — то есть полные
# дубли главной конкурировали с ней же в выдаче.
<FilesMatch "\.(?:bak|orig|backup)[-_.0-9a-zA-Z]*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/index(?:_old|_backup|_broken)[^/]*\.html$
# Каталог данных/загрузок CRM — закрыт от прямого доступа
RedirectMatch 403 ^/crm-data/.*$

# --- Внутренние файлы не отдаются наружу ---------------------------------------
# /CLAUDE.md, /README.md, /AI-STACK.md, /BRANDBOOK.md и /api/SETUP.md отдавались любому
# с кодом 200. Паролей в них нет, но там устройство сайта, схема заливки, хостинг,
# имя репозитория CRM и указание, где лежат секреты. robots.txt закрывает только /api/,
# поэтому файлы из корня ещё и попадали в индекс.
# Правило стоит на боевом с августа, в репозиторий не попало — возвращаем, иначе
# заливка .htaccess снова открыла бы эти файлы.
# Расширения перечислены поимённо: .yml НЕ закрывается — /yandex-market.yml это
# товарный фид, его читает Яндекс.Маркет.
<FilesMatch "\.(?:md|py|sh|bak|orig|log|sql|ini|dist)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# Образец конфигурации бэкенда (оканчивается на .php, под правило выше не попадает)
<FilesMatch "\.sample\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
