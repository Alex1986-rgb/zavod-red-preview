  RewriteRule ^reduktor/zr-606-6015/?$ https://%{HTTP_HOST}/reduktor/evl-767-7157 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-604/?$ https://%{HTTP_HOST}/reduktor/evl-063-747 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-605/?$ https://%{HTTP_HOST}/reduktor/evl-063-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-606/?$ https://%{HTTP_HOST}/reduktor/evl-063-767 [R=301,L,NE]
  RewriteRule ^reduktor/zr-607/?$ https://%{HTTP_HOST}/reduktor/evl-777 [R=301,L,NE]
