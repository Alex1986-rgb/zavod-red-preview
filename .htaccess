  RewriteRule ^reduktor/zr-969-939/?$ https://%{HTTP_HOST}/reduktor/evl-196-193 [R=301,L,NE]
  RewriteRule ^reduktor/zr-969x/?$ https://%{HTTP_HOST}/reduktor/evl-196x [R=301,L,NE]
  RewriteRule ^reduktor/zr-979/?$ https://%{HTTP_HOST}/reduktor/evl-197 [R=301,L,NE]
  RewriteRule ^reduktor/zr-979-939/?$ https://%{HTTP_HOST}/reduktor/evl-197-193 [R=301,L,NE]
  RewriteRule ^reduktor/zr-979x/?$ https://%{HTTP_HOST}/reduktor/evl-197x [R=301,L,NE]
