# Принудительный HTTPS + ЧИСТЫЕ URL (без .html)
# (восстановление после перезаписи CRM-деплоем — 2026-07-07)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → без www (единое зеркало, сразу на https) — против дублей хоста в индексе
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http→https через X-Forwarded-Proto (Timeweb за nginx — иначе цикл)
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Директория без слэша (/catalog) → 301 на https СО слэшем, одним хопом.
  # Без этого Apache за nginx-прокси генерит DirectorySlash-редирект на http:// —
  # даунгрейд схемы + лишний хоп. Наш rewrite срабатывает раньше DirectorySlash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # index.html → / (каталог), сразу на https
  RewriteCond %{THE_REQUEST} \s/+(([^?\s]+/)?)index\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

  # Дубли-транслитерации глоссария → канонический URL (301). Файлы на сервере остаются
  # (mirror не удаляет), но URL склеивается на старую версию — против дубль-контента.
  RewriteRule ^glossary/koefficient-perekrytiya/?$ /glossary/koeffitsient-perekrytiya [R=301,L,NE]
  RewriteRule ^glossary/tihohodnyy-val/?$ /glossary/tikhokhodnyy-val [R=301,L,NE]
  RewriteRule ^glossary/tsilindricheskiy-reduktor/?$ /glossary/cilindricheskiy-reduktor [R=301,L,NE]
  RewriteRule ^glossary/moment-inertsii/?$ /glossary/moment-inercii [R=301,L,NE]
  RewriteRule ^glossary/vibratsiya-reduktora/?$ /glossary/vibraciya-reduktora [R=301,L,NE]
  # Ошибочная атрибуция: 7Ч-М (советский червячный) был под брендом Varvel — редирект на каталог
  RewriteRule ^analog/varvel-7-(.*)$ /catalog/chervyachnye [R=301,L]

  # Исправление устаревшей маркировки ZR в URL: червячные рамы 130/150 были 6113/6115 → верно 6013/6015. Защита индексации (одним хопом на https).
  RewriteRule ^motor-reduktor-zr/(.*)6113(.*)$ https://%{HTTP_HOST}/motor-reduktor-zr/$16013$2 [R=301,L,NE]
  RewriteRule ^motor-reduktor-zr/(.*)6115(.*)$ https://%{HTTP_HOST}/motor-reduktor-zr/$16015$2 [R=301,L,NE]

  # ZR-слаги карточек редукторов → внутренние EVL-слаги (сайт в маркировке ZR, URL исторически EVL). 301, 104 шт.
  RewriteRule ^reduktor/zr-6010/?$ https://%{HTTP_HOST}/reduktor/evl-7117 [R=301,L,NE]
  RewriteRule ^reduktor/zr-6013/?$ https://%{HTTP_HOST}/reduktor/evl-7137 [R=301,L,NE]
  RewriteRule ^reduktor/zr-6015/?$ https://%{HTTP_HOST}/reduktor/evl-7157 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603/?$ https://%{HTTP_HOST}/reduktor/evl-737 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603-604/?$ https://%{HTTP_HOST}/reduktor/evl-737-747 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603-605/?$ https://%{HTTP_HOST}/reduktor/evl-737-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603-606/?$ https://%{HTTP_HOST}/reduktor/evl-737-767 [R=301,L,NE]
  RewriteRule ^reduktor/zr-604/?$ https://%{HTTP_HOST}/reduktor/evl-747 [R=301,L,NE]
  RewriteRule ^reduktor/zr-604-607/?$ https://%{HTTP_HOST}/reduktor/evl-747-777 [R=301,L,NE]
  RewriteRule ^reduktor/zr-604-609/?$ https://%{HTTP_HOST}/reduktor/evl-747-797 [R=301,L,NE]
  RewriteRule ^reduktor/zr-605/?$ https://%{HTTP_HOST}/reduktor/evl-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-605-6010/?$ https://%{HTTP_HOST}/reduktor/evl-757-7117 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606/?$ https://%{HTTP_HOST}/reduktor/evl-767 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-6013/?$ https://%{HTTP_HOST}/reduktor/evl-767-7137 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-6015/?$ https://%{HTTP_HOST}/reduktor/evl-767-7157 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-604/?$ https://%{HTTP_HOST}/reduktor/evl-063-747 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-605/?$ https://%{HTTP_HOST}/reduktor/evl-063-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606-606/?$ https://%{HTTP_HOST}/reduktor/evl-063-767 [R=301,L,NE]
  RewriteRule ^reduktor/zr-607/?$ https://%{HTTP_HOST}/reduktor/evl-777 [R=301,L,NE]
  RewriteRule ^reduktor/zr-607-605/?$ https://%{HTTP_HOST}/reduktor/evl-071-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-607-606/?$ https://%{HTTP_HOST}/reduktor/evl-071-767 [R=301,L,NE]
