# Принудительный HTTPS + ЧИСТЫЕ URL (без .html)
# (восстановление после перезаписи CRM-деплоем — 2026-07-07)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → без www (единое зеркало, сразу на https) — против дублей хоста в индексе
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http→https через X-Forwarded-Proto (Apache стоит за nginx — иначе цикл).
  # После переезда на Beget схема та же (nginx-reuseport спереди), правило
  # проверено 25.09.2026: http://zavod-red.ru/catalog/ -> 301 на https одним хопом.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Директория без слэша (/catalog) → 301 на https СО слэшем, одним хопом.
  # Без этого Apache за nginx-прокси генерит DirectorySlash-редирект на http:// —
  # даунгрейд схемы + лишний хоп. Наш rewrite срабатывает раньше DirectorySlash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # index.html → / (каталог), сразу на https
  RewriteCond %{THE_REQUEST} \s/+(([^?\s]+/)?)index\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

  # Дубли-транслитерации глоссария → канонический URL (301). Файлы на сервере остаются
  # (mirror не удаляет), но URL склеивается на старую версию — против дубль-контента.
  RewriteRule ^glossary/koefficient-perekrytiya/?$ https://%{HTTP_HOST}/glossary/koeffitsient-perekrytiya [R=301,L,NE]
  RewriteRule ^glossary/tihohodnyy-val/?$ https://%{HTTP_HOST}/glossary/tikhokhodnyy-val [R=301,L,NE]
  RewriteRule ^glossary/tsilindricheskiy-reduktor/?$ https://%{HTTP_HOST}/glossary/cilindricheskiy-reduktor [R=301,L,NE]
  RewriteRule ^glossary/moment-inertsii/?$ https://%{HTTP_HOST}/glossary/moment-inercii [R=301,L,NE]
  RewriteRule ^glossary/vibratsiya-reduktora/?$ https://%{HTTP_HOST}/glossary/vibraciya-reduktora [R=301,L,NE]
  # Дубль по IP-защите (одинаковый description, каннибализация) → канон ip-zashchita (чаще линкуется)
  RewriteRule ^glossary/stepen-zashchity-ip/?$ https://%{HTTP_HOST}/glossary/ip-zashchita [R=301,L,NE]
  # Ошибочная атрибуция: 7Ч-М (советский червячный) был под брендом Varvel — редирект на каталог
  RewriteRule ^analog/varvel-7-(.*)$ https://%{HTTP_HOST}/catalog/chervyachnye [R=301,L]

  # Файл подтверждения прав Яндекс.Вебмастера обязан отдаваться ПО СВОЕМУ адресу с .html
  # и кодом 200. Общее правило «убрать .html» уводило его в 301 — при строгой перепроверке
  # это грозит слётом верификации домена. Выводим из-под правила до всех остальных редиректов.
  RewriteRule ^yandex_[a-f0-9]+\.html$ - [L]
  RewriteRule ^google[0-9a-f]+\.html$ - [L]

  # Мусор в корне боевого, которого нет в исходниках: остатки старых версий и тестов.
  # Все отдавали 200 и были открыты для индексации; ЧЕТЫРЕ копии старой главной —
  # прямой дубль «/» и конкурент собственной главной в выдаче. Файлы НЕ удаляем
  # (зеркало их не трогает, откат = снять правило), склеиваем URL редиректами.
  RewriteRule ^index_old_[0-9][0-9-]*/?$ https://%{HTTP_HOST}/ [R=301,L]
  # /evl, /mr, /pr - точные дубли каталожных страниц (совпадают title и содержимое)
  RewriteRule ^evl/?$ https://%{HTTP_HOST}/catalog/evl [R=301,L,NE]
  RewriteRule ^mr/?$ https://%{HTTP_HOST}/catalog/mr [R=301,L,NE]
  RewriteRule ^pr/?$ https://%{HTTP_HOST}/catalog/pr [R=301,L,NE]
  # /_lbtest - копия страницы чертежей, осталась от нагрузочного теста
  RewriteRule ^_lbtest/?$ https://%{HTTP_HOST}/chertezhi [R=301,L,NE]
  # /test - пустая страница без заголовка, отдаём 410 Gone: склеивать не с чем
  RewriteRule ^test/?$ - [G]

  # Копии сайта, оставшиеся на сервере от прежних версий. Три из них отдавали 200 и
  # потому индексировались: полные дубли главной, каталога и страниц брендов,
  # конкуренты настоящих страниц по тем же запросам. Правило стоит на боевом с августа,
  # в репозиторий не попало — возвращаем, иначе заливка .htaccess его снесёт.
  RewriteRule ^_seo_backup_[0-9a-z]+/ https://%{HTTP_HOST}/ [R=301,L,NE]
  RewriteRule ^_lineup_backup_[0-9a-z]+/ https://%{HTTP_HOST}/ [R=301,L,NE]
  RewriteRule ^(blog|glossary)_backup/ https://%{HTTP_HOST}/ [R=301,L,NE]

  # Раздел /sravnenie/ снят целиком 20.08.2026 (решение владельца после претензии
  # компании «Европривод»): страницы сравнения с конкурентами больше не публикуем.
  # 410 Gone на весь раздел — склеивать с чем-либо нельзя, это не переезд контента.
  # 23.08.2026: страница /sravnenie/tehnoreduktor-ural возвращена (решение владельца,
  # претензий по ней не было, поиск её запрашивает). Остальной раздел отдаёт 410.
  RewriteCond %{REQUEST_URI} !^/sravnenie/tehnoreduktor-ural(\.html)?/?$
  RewriteRule ^sravnenie(/.*)?$ - [G]


  # Калькулятор живёт на /podbor; старый/внешний /calculator вёл в 404 → склеиваем 301.
  RewriteRule ^calculator/?$ https://%{HTTP_HOST}/podbor [R=301,L]

  # Выдуманный бренд «SEW Tramec» → реальный Tramec (Италия). SEW-Eurodrive — отдельная
  # немецкая фирма со своей страницей /brands/sew; склейка двух брендов в одном слаге была
  # ошибкой атрибуции. Одним правилом накрываем и страницу бренда, и 16 статей блога,
  # и 20 страниц аналогов — везде слаг отличается только префиксом sew-.
  RewriteRule ^brands/sew-tramec/?$ https://%{HTTP_HOST}/brands/tramec [R=301,L,NE]
  RewriteRule ^blog/(.*)sew-tramec(.*)$ https://%{HTTP_HOST}/blog/$1tramec$2 [R=301,L,NE]
  # analog/ льётся ОТДЕЛЬНЫМ ручным воркфлоу, поэтому редирект включаем только когда новый
  # файл реально доехал на сервер — иначе до деплоя analog/ отправляли бы 20 живых URL в 404.
  RewriteCond %{DOCUMENT_ROOT}/analog/tramec-$1.html -f
  RewriteRule ^analog/sew-tramec-(.*?)/?$ https://%{HTTP_HOST}/analog/tramec-$1 [R=301,L,NE]

  # Бренд Watt Drive: страница называется /brands/watt-drive, но 18 карточек аналогов
  # ссылались на /brands/watt (без -drive) → 404. Склейка коротким слагом на верную страницу.
  RewriteRule ^brands/watt/?$ https://%{HTTP_HOST}/brands/watt-drive [R=301,L,NE]

  # Исправление устаревшей маркировки ZR в URL: червячные рамы 130/150 были 6113/6115 → верно 6013/6015. Защита индексации (одним хопом на https).
  RewriteRule ^motor-reduktor-zr/(.*)6113(.*)$ https://%{HTTP_HOST}/motor-reduktor-zr/$16013$2 [R=301,L,NE]
  RewriteRule ^motor-reduktor-zr/(.*)6115(.*)$ https://%{HTTP_HOST}/motor-reduktor-zr/$16015$2 [R=301,L,NE]

  # ZR-слаги карточек редукторов → внутренние EVL-слаги (сайт в маркировке ZR, URL исторически EVL). 301, 104 шт.
  RewriteRule ^reduktor/zr-6010/?$ https://%{HTTP_HOST}/reduktor/evl-7117 [R=301,L,NE]
  RewriteRule ^reduktor/zr-6013/?$ https://%{HTTP_HOST}/reduktor/evl-7137 [R=301,L,NE]
  RewriteRule ^reduktor/zr-6015/?$ https://%{HTTP_HOST}/reduktor/evl-7157 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603/?$ https://%{HTTP_HOST}/reduktor/evl-737 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603-604/?$ https://%{HTTP_HOST}/reduktor/evl-737-747 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603-605/?$ https://%{HTTP_HOST}/reduktor/evl-737-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-603-606/?$ https://%{HTTP_HOST}/reduktor/evl-737-767 [R=301,L,NE]
  RewriteRule ^reduktor/zr-604/?$ https://%{HTTP_HOST}/reduktor/evl-747 [R=301,L,NE]
  RewriteRule ^reduktor/zr-604-607/?$ https://%{HTTP_HOST}/reduktor/evl-747-777 [R=301,L,NE]
  RewriteRule ^reduktor/zr-604-609/?$ https://%{HTTP_HOST}/reduktor/evl-747-797 [R=301,L,NE]
  RewriteRule ^reduktor/zr-605/?$ https://%{HTTP_HOST}/reduktor/evl-757 [R=301,L,NE]
  RewriteRule ^reduktor/zr-605-6010/?$ https://%{HTTP_HOST}/reduktor/evl-757-7117 [R=301,L,NE]
  RewriteRule ^reduktor/zr-606/?$ https://%{HTTP_HOST}/reduktor/evl-767 [R=301,L,NE]
